# OfficeAgent instance configuration -- REFERENCE ONLY.
#
# install.sh asks these same questions interactively and writes THREE
# separate files under /etc/officeagent/ (officeagent.env, gbrain.env,
# bot.env) consumed by the three systemd units -- it does not read this
# file directly. This file exists for people setting things up by hand
# (or debugging what install.sh should have written) to see every value
# in one place. Every value below is a placeholder -- there are NO
# working defaults baked into the product, on purpose (plan section 0.1:
# no our data, no our secrets, ever). Keep any real copy of this
# information OUTSIDE the repo and mode 0600 (install.sh already does
# this for you under /etc/officeagent/).
#
# Architecture note: only Postgres runs in Docker (docker-compose.yml,
# service `db`). bot/ and gbrain/ run as host processes under systemd
# (see systemd/*.service) -- there is no docker-compose stack for them.

# ---- Telegram ----------------------------------------------------------
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Your own Telegram numeric user id (e.g. from @userinfobot). This is the
# ONLY account the bot will treat as its owner.
OWNER_TELEGRAM_USER_ID=
# Random secret used to authenticate the bot's own loopback webhook
# (/hooks/agent, /hooks/permission/*, /hooks/model/*). Generate with:
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_TOKEN=

# ---- Claude ---------------------------------------------------------
# One of the two below, depending on how you pay for Claude Code -- OR
# leave both empty if DEFAULT_MODEL_TARGET=alt (see below), in which case
# no Anthropic credential is ever configured or used at all:
#   ANTHROPIC_API_KEY        -- pay-as-you-go API billing
#   CLAUDE_CODE_OAUTH_TOKEN  -- Claude subscription (Pro/Max) OAuth token
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# ---- Optional alternative model provider (plan section 0.4) --------------
# A second Anthropic-API-compatible endpoint (e.g. Z.ai/GLM, or any other
# provider exposing an Anthropic-compatible /v1/messages surface).
ALT_PROVIDER_BASE_URL=
ALT_PROVIDER_TOKEN=
ALT_PROVIDER_MODEL=
ALT_PROVIDER_LABEL=Alternative model

# DEFAULT_MODEL_TARGET controls how the alt provider above is used:
#   (unset)  -- alt provider is just an option /model can switch to; every
#               session starts on the primary (Anthropic) provider, so
#               ANTHROPIC_API_KEY/CLAUDE_CODE_OAUTH_TOKEN above is required.
#   alt      -- every session (first spawn AND every idle-kill respawn)
#               starts on the alt provider by default. No Anthropic
#               credential is used or required in this mode -- the two
#               ANTHROPIC_* fields above can stay empty. /model can still
#               switch back to "primary" if an Anthropic credential is
#               also configured; if not, /model only offers the alt
#               provider.
DEFAULT_MODEL_TARGET=

# ---- Optional voice transcription (Groq Whisper) -------------------
# Leave empty to disable voice-message transcription entirely.
GROQ_API_KEY=

# ---- Postgres (gbrain memory store, runs in Docker -- see docker-compose.yml) ----
PG_DATABASE=officeagent
PG_USER=officeagent
# Generate with: openssl rand -hex 24
PG_PASSWORD=
# gbrain runs on the HOST (not in a container) and reaches Postgres over
# the published port -- see docker-compose.yml's `ports: 127.0.0.1:5432`.
PG_HOST=127.0.0.1
PG_PORT=5432

# ---- gbrain --------------------------------------------------------
# Full-text search language config for Postgres tsvector columns.
# One of: russian | english | simple
FTS_LANGUAGE=english
# core = minimal always-on tool surface. all = full surface including
# slot_*/admin/diagnostic tools. Default is 'all' -- see docker-compose.yml
# comment for why 'core' is NOT the product default.
OFFICEAGENT_TOOLS=all
# Where the fastembed model is cached on first run (~1-2GB, downloaded
# once by install.sh, NOT baked into any image -- there is no image).
FASTEMBED_CACHE_PATH=/opt/officeagent/gbrain/.model-cache
HF_HOME=/opt/officeagent/gbrain/.model-cache

# ---- Bot runtime tuning -----------------------------------------------
MAX_CONCURRENT_TOPICS=4
TRANSCRIPT_GZIP_DAYS=14
TRANSCRIPT_DELETE_DAYS=90
TRANSCRIPT_MAX_MB=200
TZ=UTC

# ---- Pairing / owner token (generated by install.sh, not by hand) ----
OFFICEAGENT_OWNER_TOKEN=
PAIRING_CODE_HASH=
